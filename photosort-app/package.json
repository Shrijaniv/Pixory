{
  "name": "photosort-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|expo-modules-core|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|expo-linear-gradient|expo-blur|react-native-reanimated|@shopify)/)"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^expo-image-manipulator$": "<rootDir>/__mocks__/expo-image-manipulator.js",
      "^expo-file-system(/legacy)?$": "<rootDir>/__mocks__/expo-file-system.js",
      "^expo-media-library$": "<rootDir>/__mocks__/expo-media-library.js",
      "^expo-location$": "<rootDir>/__mocks__/expo-location.js",
      "^expo-router$": "<rootDir>/__mocks__/expo-router.js",
      "^expo-image-picker$": "<rootDir>/__mocks__/expo-image-picker.js",
      "^expo-secure-store$": "<rootDir>/__mocks__/expo-secure-store.js"
    },
    "collectCoverageFrom": [
      "lib/**/*.ts",
      "!lib/**/__tests__/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 57,
        "branches": 47,
        "functions": 62,
        "lines": 57
      }
    }
  },
  "dependencies": {
    "@expo-google-fonts/schibsted-grotesk": "^0.4.2",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@expo/ngrok": "^4.1.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/stack": "^7.8.11",
    "@shopify/flash-list": "2.0.2",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.13",
    "expo-blur": "~15.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.1",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.8.3"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.17",
    "typescript": "~5.9.2"
  },
  "private": true
}
