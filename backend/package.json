{
  "name": "pixory-backend",
  "version": "1.0.0",
  "description": "Pixory Node.js backend — AI curation + Instagram publishing",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.51.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.3.2",
    "instagram-private-api": "^1.45.3",
    "openai": "^4.96.2",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@vitest/coverage-v8": "^4.1.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  }
}
