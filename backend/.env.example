# Pixory Backend — Environment Variables
# Copy this file to .env and fill in your values

# AI API Keys (required for AI curation mode)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
# Server
PORT=8000
HOST=0.0.0.0
# Python sidecar URL (leave unset on Railway — sidecar stays local)
SIDECAR_URL=http://127.0.0.1:8001

