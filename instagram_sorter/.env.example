# ── AI API Keys (pick one or both) ───────────────────────────────────────────

# Anthropic — powers the AI Agent pipeline AND can generate captions
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — used only for caption generation in Classic Pipeline mode
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Instagram credentials ─────────────────────────────────────────────────────
# Option A: Personal account via instagrapi (default, for dev/testing)
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password

# Option B: Business account via Meta Graph API (production)
# Requires a Facebook App with instagram_basic + instagram_content_publish permissions
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
